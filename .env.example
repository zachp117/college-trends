VITE_SCORECARD_API_KEY=your_api_data_gov_key_here

# Show or hide the auth UI (Sign in / Sign up / signed-in chrome).
# Defaults: ON in `vite` dev, OFF in `vite build` production.
# Override either way:
#   VITE_AUTH_ENABLED=true   # show auth UI
#   VITE_AUTH_ENABLED=false  # hide auth UI
VITE_AUTH_ENABLED=
